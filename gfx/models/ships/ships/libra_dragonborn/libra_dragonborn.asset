entity = {
	name =  "libra_dragonborn_large_entity"
	pdxmesh = "locator_mesh"

	locator = { name = "part1" 	position = { 0 0 0 } }
	locator = { name = "wing_1_3" 	position = { 0 0 0 } }
	locator = { name = "wing_2_3" 	position = { 0 0 0 } }
	locator = { name = "wing_3_4" 	position = { 0 0 0 } }
	locator = { name = "wing_4_3" 	position = { 0 0 0 } }


	cull_radius = 10.0
	game_data = {
		size = 64
  		raytrace_projectiles = no
  		dissolve_on_death = 8.0
		ship_color = hsv { 0.6 1.0 0.75 1.0 }
 	}
}

entity = {
	name = "libra_dragonborn_large_section_entity"
	pdxmesh = "libra_dragonborn_large_mesh"
	scale = 1.0

	attach = { part1 = "libra_dragonborn_large_floater_1_entity" }               
	attach = { part1 = "libra_dragonborn_large_floater_2_entity" }  

	locator = { name = "part1" 	position = { 0 0 0 } }
	locator = { name = "wing_1_3" 	position = { 0 0 0 } }
	locator = { name = "wing_2_3" 	position = { 0 0 0 } }
	locator = { name = "wing_3_4" 	position = { 0 0 0 } }
	locator = { name = "wing_4_3" 	position = { 0 0 0 } }


	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 1.5
		start_event = { trigger_once = yes sound = { soundeffect = "aqu_dragon_idle" } }
	}
	state = { name = "moving" animation = "moving" animation_blend_time = 1
		event = { sound = { soundeffect = "aqu_dragon_move" stop_on_state_change = yes } }
	}
	state = { name = "death" animation = "death" looping = no
		event = { trigger_once = yes sound = { soundeffect = "aqu_dragon_death" } }
	}

	#state = { name = "combat_idle" animation = "idle" }
	state = { name = "combat_moving" animation = "moving" animation_blend_time =  0
		event = { sound = { soundeffect = "aqu_dragon_move" stop_on_state_change = yes } }
	}

	state = { name = "attack" animation = "attack" looping = no animation_blend_time = 1 next_state = "idle"
	#	event = { time = 0.0 particle = "ship_explosion_particle" node = "l_wing_4_4" }
	#	event = { time = 0.3 particle = "ship_explosion_particle" node = "l_wing_4_1" }
	#	event = { time = 0.6 particle = "ship_explosion_particle" node = "l_wing_4_2" }
	#	event = { time = 0.9 particle = "ship_explosion_particle" node = "l_wing_4_3" }
	#	event = { time = 1.2 particle = "ship_explosion_particle" node = "l_wing_4_4" }
		event = { trigger_once = yes sound = { soundeffect = "aqu_dragon_attack_mouth" } }
		#event = { trigger_once = yes sound = { soundeffect = "distance_dragon_attack_mouth" } }
	}

	game_data = { size = 50 }
}

entity = {
	name = "libra_dragonborn_large_floater_1_entity" 
	## Body
	pdxmesh = "libra_dragonborn_large_floater_1_mesh"

	game_data = {
		bloom_factor			= 1
		uv_animation_speed 		= 0.035
		uv_animation_direction 	= { -0.1 0.55 }
	}
		
	scale = 1

	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 1.5
	}
	state = { name = "moving" animation = "moving" animation_blend_time = 1
	}
	state = { name = "death" animation = "death" looping = no
	}

	#state = { name = "combat_idle" animation = "idle" }
	state = { name = "combat_moving" animation = "moving" animation_blend_time =  0
	}

	state = { name = "attack" animation = "attack" looping = no animation_blend_time = 1 next_state = "idle"
	}
}

